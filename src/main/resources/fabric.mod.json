{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "icon": "icon.png",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/JustMili0/MilliesConfigLib",
    "issues": "https://github.com/JustMili0/MilliesConfigLib/issues",
    "homepage": "https://modrinth.com/mod/millies-config-lib"
  },
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "main": [
      "net.justmili.config.loaders.Fabric"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_constraint}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/DPEw9DU2vT"
      },
      "badges": [
        "library"
      ]
    }
  }
}