{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "icon": "icon.png",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "https://github.com/JustMili0/MilliesConfigAndUtils",
    "issues": "https://github.com/JustMili0/MilliesConfigAndUtils/issues",
    "homepage": "https://modrinth.com/mod/millies-config-n-utils"
  },
  "license": "${mod_license}",
  "environment": "*",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "client": [
      "net.justmili.libs.client.FabricClient"
    ],
    "main": [
      "net.justmili.libs.Library"
    ],
    "modmenu": [
      "net.justmili.libs.client.ModMenuEntrypoint"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_constraint}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/DPEw9DU2vT"
      },
      "badges": [
        "library"
      ]
    }
  }
}